{
  "name": "webmotors-plus",
  "description": "Extensão do Chrome que amplia a busca da Webmotors: busca com IA no cabeçalho, lista negra de marcas e modelos e árvore de resultados com FIPE e preço médio.",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:dev": "wxt build --mode development",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "fuse.js": "^7.5.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@preact/preset-vite": "^2.10.6",
    "@wxt-dev/auto-icons": "^1.1.2",
    "happy-dom": "^21.0.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11",
    "wxt": "^0.21.4"
  }
}
